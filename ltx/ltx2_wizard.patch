+        sigma = timesteps[:, -1].clone()                                       # (B,)
+        sig = timesteps.view(batch_size, num_frames, tokens_per_frame)[:, :, 0].clone()   # (B, F) per-frame levels
+
+        for b_idx in range(batch_size):
+            if not bool(applied[b_idx]):
+                continue
+            drop = config.context_drop_prob > 0 and torch.rand(()).item() < config.context_drop_prob
+            use_ctx = (not drop) and config.context_noise_max > 0 and torch.rand(()).item() < config.context_noise_prob
+            sigma_c = 1.0 if drop else (float(torch.rand(()).item() * config.context_noise_max) if use_ctx else 0.0)
+            use_mono = config.monotone_target_prob > 0 and torch.rand(()).item() < config.monotone_target_prob
+            full_mono = use_mono and torch.rand(()).item() < config.full_monotone_prob
+            ramp = use_ctx and torch.rand(()).item() < config.context_ramp_prob
