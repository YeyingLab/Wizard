+    def _apply_prefix_noise_schedule(
+        clean: Tensor,
+        noise: Tensor,
+        timesteps: Tensor,
+        prefix_mask: Tensor,
+        applied: Tensor,
+        config: PrefixConditionConfig,
+        boundary: int,
