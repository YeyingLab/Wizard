@@ -0,0 +1,138 @@
+# NOTICE: this file was modified (or added) by the Wizard authors, 2026, for reference-image slot binding,
+# KV-cached causal attention and proxy-video conditioning. Distributed under the LTX-2.x Community License.
+"""Per-layer K/V caches for chunk-causal streaming inference.
+
+What is cached
+--------------
+For one ``Attention`` layer, the keys *after* ``k_norm`` + RoPE and the raw
+values of tokens that are already final (clean, timestep 0). Because LTX RoPE
+is purely relative in ``q·k`` (``rope.py``: ``freqs = idx * (pos/max_pos*2-1)``,
+no clamping), cached keys carry their own absolute positions and stay valid as
+the timeline grows; only the *relative* span between a query and its oldest
+cached key must stay inside the span seen in training, which ``evict_front``
+maintains for a sliding window.
+
+Why a view with separate read sources and a write target
+--------------------------------------------------------
+Under the block-causal mask the white-box reference tokens never attend to the
+target tokens, while target tokens attend to both. Instead of a mask, the
+streaming loop runs each new frame as two sub-passes:
+
+    reference frame f : reads [reference cache]              writes reference cache
+    target    frame f : reads [reference cache, target cache] writes target cache (only once clean)
+
+Attention itself never sees a mask on this path, so it runs on the unmasked
+flash kernel; the causal structure is entirely in what each view can read.
+"""
+
+from __future__ import annotations
+
+import torch
+
+__all__ = ["LayerKVCache", "KVCacheView"]
+
+
+class LayerKVCache:
+    """K/V store for a single attention layer, tokens appended in stream order."""
+
+    def __init__(self) -> None:
+        self._k: list[torch.Tensor] = []  # each (B, T_i, H*D), post-norm, post-RoPE
+        self._v: list[torch.Tensor] = []  # each (B, T_i, H*D), raw values
+
+    @property
+    def num_tokens(self) -> int:
+        return sum(t.shape[1] for t in self._k)
+
+    def append(self, k: torch.Tensor, v: torch.Tensor) -> None:
+        self._k.append(k.detach())
+        self._v.append(v.detach())
+
+    def evict_front(self, num_tokens: int) -> None:
+        """Drop the oldest ``num_tokens`` tokens (sliding window)."""
+        while num_tokens > 0 and self._k:
+            t = self._k[0].shape[1]
+            if t <= num_tokens:
+                self._k.pop(0)
+                self._v.pop(0)
+                num_tokens -= t
+            else:
+                self._k[0] = self._k[0][:, num_tokens:]
+                self._v[0] = self._v[0][:, num_tokens:]
+                num_tokens = 0
+
+    def evict_range(self, start: int, num_tokens: int) -> None:
+        """Drop ``num_tokens`` tokens beginning at token offset ``start`` (used to pin a sink frame at 0)."""
+        k = torch.cat(self._k, dim=1); v = torch.cat(self._v, dim=1)
+        keep = torch.ones(k.shape[1], dtype=torch.bool, device=k.device); keep[start:start + num_tokens] = False
+        self._k = [k[:, keep]]; self._v = [v[:, keep]]
+
+    def clear(self) -> None:
+        self._k.clear()
+        self._v.clear()
+
+    def tensors(self) -> tuple[list[torch.Tensor], list[torch.Tensor]]:
+        return self._k, self._v
+
+
+class KVCacheView:
+    """What an ``Attention`` layer is handed for one sub-pass.
+
+    ``read`` caches are concatenated (in the given order) in front of the new
+    tokens' K/V; ``write`` receives the new tokens' K/V after the attention
+    call, or nothing when ``None`` (e.g. a noisy target pass mid-denoising).
+    """
+
+    def __init__(
+        self,
+        read: list[LayerKVCache],
+        write: LayerKVCache | None = None,
+        read_limits: list[int | None] | None = None,
+        read_ranges: list[list[tuple[int, int]] | None] | None = None,
+    ) -> None:
+        self.read = read
+        self.write = write
+        # Optional per-read-cache cap on how many of its oldest tokens are visible. Lets a cache that
+        # already holds a whole (block-causal) reference stream be read "aligned" -- only frames <= f --
+        # without re-committing it frame by frame.
+        self.read_limits = read_limits
+        # Optional per-read-cache list of token ranges [start, end) to gather, in order (e.g. a pinned sink
+        # frame plus a sliding window). Ranges are applied to the cache's full token stream; empty ranges are
+        # skipped. Takes precedence over ``read_limits`` for that cache. Used by cache-aware training, where
+        # one pass holds several query frames and the (rectangular) attention mask does the per-query part.
+        self.read_ranges = read_ranges
+
+    def gather(self, k_new: torch.Tensor, v_new: torch.Tensor) -> tuple[torch.Tensor, torch.Tensor]:
+        ks: list[torch.Tensor] = []
+        vs: list[torch.Tensor] = []
+        for i, c in enumerate(self.read):
+            k_list, v_list = c.tensors()
+            ranges = self.read_ranges[i] if self.read_ranges is not None else None
+            if ranges is not None:
+                if k_list:
+                    k_cat = torch.cat(k_list, dim=1) if len(k_list) > 1 else k_list[0]
+                    v_cat = torch.cat(v_list, dim=1) if len(v_list) > 1 else v_list[0]
+                    for s, e in ranges:
+                        e = min(e, k_cat.shape[1])
+                        if e > s:
+                            ks.append(k_cat[:, s:e])
+                            vs.append(v_cat[:, s:e])
+                continue
+            limit = self.read_limits[i] if self.read_limits is not None else None
+            if limit is not None and k_list:
+                k_cat = torch.cat(k_list, dim=1)[:, :limit]
+                v_cat = torch.cat(v_list, dim=1)[:, :limit]
+                if k_cat.shape[1] > 0:
+                    ks.append(k_cat)
+                    vs.append(v_cat)
+                continue
+            ks.extend(k_list)
+            vs.extend(v_list)
+        ks.append(k_new)
+        vs.append(v_new)
+        if len(ks) == 1:
+            return k_new, v_new
+        return torch.cat(ks, dim=1), torch.cat(vs, dim=1)
+
+    def commit(self, k_new: torch.Tensor, v_new: torch.Tensor) -> None:
+        if self.write is not None:
+            self.write.append(k_new, v_new)
