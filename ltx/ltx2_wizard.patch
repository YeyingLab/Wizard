+# NOTICE: this file was modified (or added) by the Wizard authors, 2026, for reference-image slot binding,
+# KV-cached causal attention and proxy-video conditioning. Distributed under the LTX-2.x Community License.
+"""Block-causal self-attention masks for chunk-wise LTX rollout.
+
+Why a mask at all
+-----------------
+Without one the window is fully bidirectional, so a token's K/V depend on every
+other token in the window -- including the noisy ones still being denoised. That
+makes them change at every denoising step and every rollout round, which is why
+the settled past cannot be cached and each chunk costs a full-window recompute.
+
+Under block-causal attention a block only attends to blocks at or before it, so
+once a block is clean its K/V are final. That is the property a KV cache needs.
+
+Sequence layout (see FlexibleTrainingStrategy._apply_reference_condition)
+------------------------------------------------------------------------
+Reference latents are concatenated *before* the target::
+
+    [ reference: F frames ][ target: F frames ]
+      tokens_per_frame each, so T = 2 * F * tokens_per_frame
+
+`reference_mode` decides what the reference half may be attended to:
+
+``"aligned"`` (default)
+    Reference frame *f* sits in the same causal block as target frame *f*, so a
+    target block sees reference frames up to its own and no further. This is the
+    honest deployment geometry: at chunk *k* the engine has rendered white-box
+    frames through chunk *k* and no more. Letting training peek at later
+    white-box frames would train a dependency inference cannot supply.
+
+``"global"``
+    Every target block sees the whole reference half (OmniForcing's "Global
+    Prefix"). Only correct when the entire control signal really is available up
+    front -- e.g. rendering a fixed UE take offline rather than driving a live
+    engine.
+
+Blocks are assigned by latent frame index, uniformly across both halves::
+
+    frame 0 .. first_block_frames-1          -> block 0
+    then every `block_size` frames           -> block 1, 2, ...
+
+`first_block_frames` exists because the video VAE is causal: its first latent
+frame covers a single pixel frame while the rest cover eight, so the first block
+usually wants one extra frame to line up with a round number of pixel frames.
+Setting `block_size >= num_frames` reproduces full bidirectional attention,
+which makes "no mask" a special case of this function rather than a separate
+code path.
+"""
+
+from __future__ import annotations
+
+import torch
+
+__all__ = ["assign_blocks", "build_block_causal_mask", "build_clean_copy_tf_mask"]
+
+
+def assign_blocks(
+    num_frames: int,
+    block_size: int,
+    first_block_frames: int | None = None,
+) -> list[int]:
+    """Map each latent frame index to its causal block index.
+
+    Returns a list of length ``num_frames``; entry *f* is the block owning frame
+    *f*. Block indices are consecutive from 0.
+    """
+    if num_frames < 1:
+        raise ValueError(f"num_frames must be >= 1, got {num_frames}")
+    if block_size < 1:
+        raise ValueError(f"block_size must be >= 1, got {block_size}")
+    first = block_size if first_block_frames is None else first_block_frames
+    if first < 1:
+        raise ValueError(f"first_block_frames must be >= 1, got {first}")
+
+    blocks: list[int] = []
+    frame = 0
+    block_idx = 0
+    while frame < num_frames:
+        span = first if block_idx == 0 else block_size
+        for _ in range(min(span, num_frames - frame)):
+            blocks.append(block_idx)
+        frame += span
+        block_idx += 1
+    return blocks
+
+
+def build_block_causal_mask(
+    num_frames: int,
+    tokens_per_frame: int,
+    block_size: int,
+    *,
+    has_reference: bool = True,
+    reference_first: bool = True,
+    reference_mode: str = "aligned",
+    first_block_frames: int | None = None,
+    batch_size: int = 1,
+    device: torch.device | str = "cpu",
+    dtype: torch.dtype = torch.float32,
+) -> torch.Tensor:
+    """Build a ``(batch_size, T, T)`` mask in the [0, 1] convention Modality wants.
+
+    1.0 means the query may attend to the key, 0.0 means it may not.
+    ``Modality.attention_mask`` takes exactly this; the transformer converts it
+    to an additive log-space bias itself.
+
+    Args:
+        num_frames: latent frames in the *target* half.
+        tokens_per_frame: tokens per latent frame, ``(H // 32) * (W // 32)`` for
+            LTX at patch_size 1.
+        block_size: latent frames per causal block. ``1`` is frame-wise;
+            ``>= num_frames`` degenerates to full bidirectional attention.
+        has_reference: whether reference latents are concatenated with the target.
+        reference_first: layout of the concatenation. The trainer prepends the
+            reference (``[reference][target]``, see
+            ``FlexibleStrategy._apply_reference_condition``) while the validation
+            runner appends it (``[target][reference]``). RoPE positions make the
+            model indifferent to the order, but the mask must know where each
+            half lives.
+        reference_mode: ``"aligned"`` or ``"global"`` -- see the module docstring.
+        first_block_frames: frames in block 0 (defaults to ``block_size``).
+    """
+    if reference_mode not in ("aligned", "global"):
+        raise ValueError(f"reference_mode must be 'aligned' or 'global', got {reference_mode!r}")
+    if tokens_per_frame < 1:
+        raise ValueError(f"tokens_per_frame must be >= 1, got {tokens_per_frame}")
+
+    frame_blocks = assign_blocks(num_frames, block_size, first_block_frames)
+
+    # Per-token block id for the whole sequence. The reference half repeats the
+    # target's block assignment so frame f lines up with frame f across halves.
+    per_frame = torch.tensor(frame_blocks, dtype=torch.long, device=device)
+    target_token_blocks = per_frame.repeat_interleave(tokens_per_frame)
+
+    half = num_frames * tokens_per_frame
+    if has_reference:
+        # Both halves share the per-frame block assignment so frame f lines up
+        # with frame f across halves regardless of which half comes first.
+        token_blocks = torch.cat([target_token_blocks, target_token_blocks])
+        if reference_first:
+            ref_slice, tgt_slice = slice(0, half), slice(half, 2 * half)
+        else:
+            ref_slice, tgt_slice = slice(half, 2 * half), slice(0, half)
+    else:
+        token_blocks = target_token_blocks
+
+    # Block-causal: query in block q attends to keys in blocks <= q.
+    allowed = token_blocks.unsqueeze(1) >= token_blocks.unsqueeze(0)  # (T, T)
+
+    if has_reference:
+        # The reference half never attends to the target half. Two reasons, and
+        # either alone would justify it: the white-box is an input, so letting
+        # the generation feed back into it is meaningless; and if reference
+        # tokens attended to noisy target tokens their K/V would change at every
+        # denoising step, which is exactly the property a KV cache needs them
+        # not to have. Reference tokens stay block-causal among themselves so a
+        # sliding window does not rewrite the K/V of white-box frames it has
+        # already seen.
+        allowed[ref_slice, tgt_slice] = False
+
+        if reference_mode == "global":
+            # Every target query sees the whole reference half. Deliberately
+            # scoped to target rows so the rule above still holds.
+            allowed[tgt_slice, ref_slice] = True
+
+    mask = allowed.to(dtype).unsqueeze(0)
+    if batch_size != 1:
+        mask = mask.expand(batch_size, -1, -1)
+    return mask
+
+
+def build_clean_copy_tf_mask(
+    num_frames: int,
+    tokens_per_frame: int,
+    block_size: int,
+    *,
+    has_reference: bool = True,
+    reference_mode: str = "aligned",
+    first_block_frames: int | None = None,
+    batch_size: int = 1,
+    device: torch.device | str = "cpu",
+    dtype: torch.dtype = torch.float32,
+) -> torch.Tensor:
+    """Teacher-forcing mask with a clean copy of the target (Causal Forcing / Causal-rCM layout).
+
+    Training-only layout, ``[reference F][clean F][noisy F]`` (or ``[clean F][noisy F]``):
+
+        noisy block q  ->  noisy block == q          (its own tokens only; noisy blocks never see each other)
+                       ->  clean blocks  <  q        (the honest history: what the KV cache holds at inference)
+                       ->  reference blocks <= q     (aligned; "global" exposes the whole reference)
+        clean block q  ->  clean blocks <= q, reference blocks <= q   (exactly the commit pass at inference)
+        reference      ->  reference blocks <= q only
+
+    Every noisy block therefore trains "generate one block given an all-clean history", which is the
+    geometry streaming inference produces, and the loss covers every history length in one sample.
+    Nothing ever attends to a noisy block other than itself, so clean/reference K/V are cacheable.
+    """
+    if reference_mode not in ("aligned", "global"):
+        raise ValueError(f"reference_mode must be 'aligned' or 'global', got {reference_mode!r}")
+    if tokens_per_frame < 1:
+        raise ValueError(f"tokens_per_frame must be >= 1, got {tokens_per_frame}")
+
+    per_frame = torch.tensor(assign_blocks(num_frames, block_size, first_block_frames), dtype=torch.long, device=device)
+    blk = per_frame.repeat_interleave(tokens_per_frame)  # (half,)
+    half = num_frames * tokens_per_frame
+
+    segments = ["ref", "clean", "noisy"] if has_reference else ["clean", "noisy"]
+    offsets = {name: i * half for i, name in enumerate(segments)}
+    total = len(segments) * half
+    allowed = torch.zeros(total, total, dtype=torch.bool, device=device)
+
+    q_blk = blk.unsqueeze(1)  # (half, 1)
+    k_blk = blk.unsqueeze(0)  # (1, half)
+    le = q_blk >= k_blk
+    lt = q_blk > k_blk
+    eq = q_blk == k_blk
+
+    def put(q: str, k: str, rule: torch.Tensor) -> None:
+        qs, ks = offsets[q], offsets[k]
+        allowed[qs : qs + half, ks : ks + half] = rule
+
+    put("noisy", "noisy", eq)
+    put("noisy", "clean", lt)
+    put("clean", "clean", le)
+    if has_reference:
+        ref_rule = torch.ones_like(le) if reference_mode == "global" else le
+        put("noisy", "ref", ref_rule)
